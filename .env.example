# NVIDIA API Key（https://build.nvidia.com，通常以 nvapi- 開頭）
NVIDIA_API_KEY=nvapi-xxxxxxxx

# 模型（預設 google/gemma-4-31b-it）
# NVIDIA_MODEL=google/gemma-4-31b-it
# 其他可選：google/gemma-3-12b-it、meta/llama-3.1-8b-instruct、nvidia/nemotron-3-nano-30b-a3b

# Turso（案件與懲罰狀態持久化）
TURSO_DATABASE_URL=libsql://your-db-name-org.turso.io
TURSO_AUTH_TOKEN=eyJ...

# NEXT_PUBLIC_SITE_URL=https://balacourt.illusd.com
